# Local development configuration
NODE_ENV=development
DB_CONNECTION=local
PORT=5000
FRONTEND_ORIGIN=http://localhost:5173

# Replace with a secure random secret before deployment
JWT_SECRET=replace_this_with_a_secure_random_secret_before_deployment

# PostgreSQL configuration
DB_USER=your_database_user
DB_HOST=localhost
DB_NAME=seefixit
DB_PASSWORD=your_database_password
DB_PORT=5432
# PostgreSQL SSL
# Local development: false
# Production with local PostgreSQL: true
DB_SSL=false

# Neon URLs (used only when DB_CONNECTION=neon)
# DATABASE_URL=your_neon_pooled_connection_string
# DIRECT_DATABASE_URL=your_neon_direct_connection_string
